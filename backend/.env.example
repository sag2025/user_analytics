# Copy to .env and fill in. Never commit .env
PORT=4000
NODE_ENV=development

# Atlas: Connect -> Drivers -> copy the string, add the database name before the "?"
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/user_analytics?retryWrites=true&w=majority

# Comma separated list of allowed frontend origins (your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173

# Long random string used to sign admin tokens, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Hardcoded admin (as requested). Change them in Render's env settings for production.
ADMIN_NAME=dontknow
ADMIN_PASSWORD=dontknow

# How long a login session lasts
SESSION_TTL_HOURS=24
